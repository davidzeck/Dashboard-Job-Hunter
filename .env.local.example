# Job Scout Dashboard - Environment Variables
# Copy this file to .env.local and update values

# API Configuration
# Browser-visible base path — keep RELATIVE (/api/v1) so requests go through
# the Next.js same-origin proxy and the httpOnly refresh cookie works.
# Required: the app talks to the real backend only (no demo/mock mode).
NEXT_PUBLIC_API_URL=/api/v1

# Server-only: backend target of the /api/v1 rewrite proxy
API_PROXY_URL=http://localhost:8000/api/v1

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
